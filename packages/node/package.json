{
  "name": "telebot-ts",
  "version": "1.3.0",
  "description": "Zero-dependency, type-safe Telegram Bot framework for Node.js and TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "import": "./dist/filters/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js"
    },
    "./ui": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "import": "./dist/nest/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"tests/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\" \"tests/**/*.{ts,js,json,md}\"",
    "commit": "cz",
    "docs": "typedoc"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-bot-api",
    "telegram-bot-framework",
    "telegram-api",
    "bot",
    "bot-framework",
    "telegram-stars",
    "telegram-payments",
    "telegram-mini-app",
    "tma",
    "rrule",
    "rrule-scheduler",
    "cron",
    "scheduler",
    "typescript",
    "zero-dependency",
    "native-fetch",
    "sqlite-persistence",
    "conversation-handler",
    "nestjs-telegram",
    "fast",
    "lightweight"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nam088/telebot.git"
  },
  "homepage": "https://Nam088.github.io/telebot/",
  "bugs": {
    "url": "https://github.com/Nam088/telebot/issues"
  },
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "pino": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "ts-morph": "28.0.0",
    "tsup": "8.5.1",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  }
}
