{
  "name": "tele-bot",
  "version": "1.0.0",
  "description": "Zero-dependency, type-safe Telegram Bot framework for Node.js and TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.js"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "import": "./dist/filters/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js"
    },
    "./ui": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "dev:echo": "tsx examples/echobot.ts",
    "dev:keyboard": "tsx examples/inlinekeyboard.ts",
    "dev:conversation": "tsx examples/conversationbot.ts",
    "dev:timer": "tsx examples/timerbot.ts",
    "dev:poll": "tsx examples/pollbot.ts",
    "dev:chatmember": "tsx examples/chatmemberbot.ts",
    "dev:deeplink": "tsx examples/deeplinking.ts",
    "dev:webhook": "tsx examples/webhookbot.ts"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "bot",
    "framework",
    "typescript",
    "zero-dependency"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "pino": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
